{
  "name": "simped",
  "private": true,
  "version": "0.0.0",
  "description": "Simulador de Prescrição em Emergências Pediátricas",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "arquivo-unico": "vite build && node scripts/arquivo-unico.mjs",
    "desktop": "node node_modules/electron/install.js && npm run arquivo-unico && electron .",
    "empacotar:mac": "npm run arquivo-unico && electron-builder --mac",
    "empacotar:win": "npm run arquivo-unico && electron-builder --win",
    "empacotar:linux": "npm run arquivo-unico && electron-builder --linux"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.simped.app",
    "productName": "SimPed",
    "directories": {
      "output": "instaladores"
    },
    "files": [
      "electron/**",
      "dist-arquivo/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "author": "SimPed"
}
